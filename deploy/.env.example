# ---------- 必填：生产环境务必改 ----------
APP_ENV=production
APP_DEBUG=false

# 强随机：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 首次启动的管理员口令（建库后不再生效，改密码请走用户管理）
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ---------- 存储 ----------
# SQLite（零配置，单机开发/小团队）
DATABASE_URL=sqlite:////app/data/campaign_edit.db

# PostgreSQL（推荐：支持多worker 并发写）
# DATABASE_URL=postgresql+psycopg://ce:CHANGE_ME@db:5432/campaign_edit

# ---------- CORS ----------
# 多个用逗号分隔
CORS_ORIGINS=http://localhost:8088

# ---------- 意图识别 LLM ----------
# 不配置也能跑：自动降级为规则通道，功能完整，只是长句需人工确认
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30

# 意图仲裁阈值
INTENT_RULE_WEIGHT=0.45
INTENT_LLM_WEIGHT=0.55
INTENT_MIN_CONFIDENCE=0.35
INTENT_AUTO_TEMPLATE_SCORE=0.55

# ---------- Mautic 投递 ----------
MAUTIC_API_ENABLED=false
MAUTIC_BASE_URL=
MAUTIC_USERNAME=
MAUTIC_PASSWORD=

# ---------- 插件 ----------
# 安全：远程安装默认关闭
PLUGIN_ALLOW_REMOTE_INSTALL=false
PLUGIN_DIR=/app/plugins

# ---------- Web ----------
WEB_PORT=8088

# ---------- Postgres profile ----------
POSTGRES_PASSWORD=CHANGE_ME